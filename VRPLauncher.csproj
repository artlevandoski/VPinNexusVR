<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VRPLauncher</RootNamespace>
    <AssemblyName>VRPLauncher</AssemblyName>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <!-- Built-in fallback pictures, compiled into the exe. Loaded by name, e.g. "Defaults.rules_default.png". -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\Defaults\*.png" LogicalName="Defaults.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
