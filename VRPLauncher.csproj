<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>VRPLauncher</RootNamespace>
    <AssemblyName>VPinNexusVR</AssemblyName>
    <!-- Shown in the settings window title and used by release.cmd for the zip name. -->
    <Version>0.1.0-beta</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationIcon>Assets\Brand\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <!-- Built-in fallback pictures and music, compiled into the exe. Loaded by name, e.g. "Defaults.rules_default.png". -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\Defaults\*.png" LogicalName="Defaults.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\Audio\*.mp3" LogicalName="Audio.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Brand fonts (SIL Open Font License, see Assets\Fonts\OFL-*.txt) and logo, compiled into the exe as WPF resources. -->
  <ItemGroup>
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\Brand\Logo.png" />
    <Resource Include="Assets\Brand\AppIcon.ico" />
  </ItemGroup>

</Project>
