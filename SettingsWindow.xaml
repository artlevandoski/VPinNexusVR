<Window x:Class="VRPLauncher.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VR Pinball Launcher - Settings"
        Width="1000" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#202020" FontFamily="Segoe UI" FontSize="18">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFD400" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Margin" Value="0,18,0,6" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A0A0A0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="30,12,30,24">

        <TextBlock Style="{StaticResource Heading}" Text="VPX executable" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseVpx_Click" />
            <TextBox x:Name="VpxExeBox" TextChanged="Field_Changed" />
        </DockPanel>
        <TextBlock x:Name="VpxStatus" Style="{StaticResource Hint}" />

        <TextBlock Style="{StaticResource Heading}" Text="Launch arguments" />
        <TextBox x:Name="ArgumentsBox" />
        <TextBlock Style="{StaticResource Hint}"
                   Text="{}{table} is replaced with the full path of the selected table. Default: -Minimized -Play &quot;{table}&quot;" />

        <TextBlock Style="{StaticResource Heading}" Text="Tables folder" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseTables_Click" />
            <TextBox x:Name="TablesBox" TextChanged="Field_Changed" />
        </DockPanel>
        <CheckBox x:Name="SubfoldersBox" Content="Include subfolders" Click="Field_Changed" />
        <TextBlock x:Name="TablesStatus" Style="{StaticResource Hint}" />

        <TextBlock Style="{StaticResource Heading}" Text="Wheel / image folders (searched top to bottom)" />
        <DockPanel>
            <StackPanel DockPanel.Dock="Right">
                <Button Content="Add…" Click="AddImageFolder_Click" />
                <Button Content="Remove" Click="RemoveImageFolder_Click" Margin="8,8,0,0" />
                <Button Content="Move up" Click="MoveUp_Click" Margin="8,8,0,0" />
                <Button Content="Move down" Click="MoveDown_Click" Margin="8,8,0,0" />
            </StackPanel>
            <ListBox x:Name="ImageFoldersList" Height="150" />
        </DockPanel>
        <TextBlock x:Name="ImagesStatus" Style="{StaticResource Hint}" />
        <CheckBox x:Name="DirectB2SBox" Content="Use the backglass image from a matching .directb2s file" />

        <TextBlock Style="{StaticResource Heading}" Text="Display" />
        <CheckBox x:Name="FullscreenBox" Content="Fullscreen (hides the mouse pointer)" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,28,0,0">
            <Button Content="Save" IsDefault="True" Click="Save_Click" FontWeight="Bold" />
            <Button Content="Cancel" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
