<Window x:Class="VRPLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VPin Nexus VR"
        Width="1280" Height="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource MidnightNavy}"
        FontFamily="{StaticResource BodyFont}">

    <Window.Resources>
        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource TitleFont}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </Window.Resources>

    <!-- Everything is laid out at 1920x1080 and scaled to the window, so text stays proportionally large at any resolution. -->
    <Viewbox Stretch="Uniform">
        <Grid Width="1920" Height="1080">
            <Grid.RowDefinitions>
                <RowDefinition Height="150" />
                <RowDefinition Height="*" />
                <RowDefinition Height="210" />
                <RowDefinition Height="80" />
            </Grid.RowDefinitions>

            <!-- Header: logo and active filter, current letter, last key and position -->
            <StackPanel Grid.Row="0" Margin="40,0" Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="{StaticResource Logo}" Height="140" RenderOptions.BitmapScalingMode="HighQuality" />
                <Border x:Name="FilterPanel" Margin="24,0,0,0" VerticalAlignment="Center" Padding="18,6"
                        CornerRadius="8" BorderThickness="2" BorderBrush="{StaticResource NexusCyan}" Visibility="Collapsed">
                    <TextBlock x:Name="FilterText" Style="{StaticResource Title}" FontSize="30" Foreground="{StaticResource NexusCyan}" />
                </Border>
            </StackPanel>
            <TextBlock x:Name="LetterText" Grid.Row="0" Style="{StaticResource Title}" FontWeight="Black"
                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="64" Foreground="{StaticResource NexusCyan}" />
            <StackPanel Grid.Row="0" Margin="50,0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="LastKeyText" VerticalAlignment="Center" Margin="0,0,40,0" FontSize="24" Foreground="{StaticResource ChromeMidtone}" />
                <TextBlock x:Name="CounterText" Style="{StaticResource Title}" VerticalAlignment="Center" FontSize="42"
                           Foreground="{StaticResource SilverWhite}" />
            </StackPanel>

            <!-- Carousel: the selected table in the middle, two neighbours on each side. Slots are created in code. -->
            <Grid x:Name="Carousel" Grid.Row="1" Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.8*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="2.4*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="0.8*" />
                </Grid.ColumnDefinitions>
            </Grid>

            <!-- Selected table: title, VPS game info and update notice -->
            <StackPanel Grid.Row="2" VerticalAlignment="Center" Margin="60,0">
                <TextBlock x:Name="TitleText" Style="{StaticResource Title}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                           FontSize="52" Foreground="{StaticResource SilverWhite}" />
                <TextBlock x:Name="InfoText" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                           FontSize="28" Foreground="{StaticResource ChromeMidtone}" Margin="0,8,0,0" />
                <Border x:Name="UpdatePanel" HorizontalAlignment="Center" Margin="0,12,0,0" Padding="16,4"
                        CornerRadius="8" Background="{StaticResource VrOrange}" Visibility="Collapsed">
                    <TextBlock x:Name="UpdateText" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource BadgeInk}" />
                </Border>
            </StackPanel>

            <!-- Footer: controls help -->
            <Border Grid.Row="3" Background="{StaticResource PanelNavy}" BorderBrush="{StaticResource NexusCyan}" BorderThickness="0,2,0,0">
                <TextBlock x:Name="HelpText" Margin="40,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="29" Foreground="{StaticResource SilverWhite}" />
            </Border>

            <!-- Errors and notices -->
            <Border x:Name="StatusPanel" Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    Background="#B00020" CornerRadius="10" Padding="30,12" Visibility="Collapsed">
                <TextBlock x:Name="StatusText" FontSize="34" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" MaxWidth="1700" />
            </Border>

            <!-- Playfield / rules viewer -->
            <Grid x:Name="ViewerPanel" Grid.RowSpan="4" Background="{StaticResource MidnightNavy}" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="100" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="80" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="ViewerCaption" Grid.Row="0" Style="{StaticResource Title}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="1800" FontSize="42" Foreground="{StaticResource NexusCyan}" />
                <Image x:Name="ViewerImage" Grid.Row="1" Stretch="Uniform" Margin="40,0" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock x:Name="ViewerMessage" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" FontSize="44" Foreground="{StaticResource ChromeMidtone}" />
                <Border Grid.Row="2" Background="{StaticResource PanelNavy}" BorderBrush="{StaticResource NexusCyan}" BorderThickness="0,2,0,0">
                    <TextBlock x:Name="ViewerHint" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="29" Foreground="{StaticResource SilverWhite}" />
                </Border>
            </Grid>

            <!-- Hold-to-exit feedback -->
            <Border x:Name="ExitPanel" Grid.RowSpan="4" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource PanelNavy}" BorderBrush="{StaticResource NexusCyan}" BorderThickness="4" CornerRadius="16" Padding="60,40"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="KEEP HOLDING TO QUIT" Style="{StaticResource Title}" FontSize="56" Foreground="{StaticResource SilverWhite}"
                               HorizontalAlignment="Center" />
                    <ProgressBar x:Name="ExitProgress" Height="30" Width="800" Margin="0,30,0,0" Maximum="1"
                                 Foreground="{StaticResource NexusCyan}" Background="{StaticResource ChromeShadow}" BorderThickness="0" />
                </StackPanel>
            </Border>

            <!-- Shown while VPX is running -->
            <Grid x:Name="PlayingPanel" Grid.RowSpan="4" Background="{StaticResource MidnightNavy}" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center">
                    <Image Source="{StaticResource Logo}" Height="220" HorizontalAlignment="Center" Margin="0,0,0,40"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="NOW PLAYING" Style="{StaticResource Title}" FontWeight="Black" FontSize="48"
                               Foreground="{StaticResource VrOrange}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="PlayingText" Style="{StaticResource Title}" FontSize="72" Foreground="{StaticResource SilverWhite}"
                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="1800" Margin="0,20,0,0" />
                    <TextBlock Text="Quit the table in VPX to come back here" FontSize="36" Foreground="{StaticResource ChromeMidtone}"
                               HorizontalAlignment="Center" Margin="0,40,0,0" />
                </StackPanel>
            </Grid>
        </Grid>
    </Viewbox>
</Window>
